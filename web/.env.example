# Copy to .env.local for local development. On a host such as Vercel, set these
# in the project's environment variables instead.

# Shared secret the sensor node sends as "Authorization: Bearer <token>".
# Must match INGEST_TOKEN in /etc/sensor/uploader.env on the Pi.
# Required in production; when unset in development, uploads are accepted without it.
INGEST_TOKEN=change-me

# Where readings are stored. Defaults to a local SQLite file (data/sensor.db).
# Serverless hosts need a hosted libSQL database, e.g. Turso:
#   DATABASE_URL=libsql://<database>-<org>.turso.io
#   DATABASE_AUTH_TOKEN=<token from `turso db tokens create <database>`>
# DATABASE_URL=file:data/sensor.db
# DATABASE_AUTH_TOKEN=
